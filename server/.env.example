# Öffentliche Adresse der App (für Stripe-Weiterleitungen und sichere Cookies)
PUBLIC_URL=https://melody.example.com
PORT=8080
NODE_ENV=production

# Stripe (https://dashboard.stripe.com/apikeys) – ohne Key läuft lokal ein Testmodus
STRIPE_SECRET_KEY=sk_live_...
# Webhook-Endpunkt: https://melody.example.com/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# KI-Empfehlungen (https://console.anthropic.com) – ohne Key nutzt die App ihre eingebaute Engine
ANTHROPIC_API_KEY=sk-ant-...
# MELODY_AI_MODEL=claude-opus-5-5
# MELODY_AI_DAILY_LIMIT=5

# Weltweite Song-Erkennung (https://audd.io) – ohne Token nur Melody-Katalog
AUDD_API_TOKEN=

# Datenbank-Datei (Standard: server/data/melody.db)
# MELODY_DB=/var/lib/melody/melody.db
